# Copy to .env and fill in. .env is git-ignored.
# Supabase: Project Settings -> Database -> Connection string -> Session pooler (IPv4).
# The direct host db.<ref>.supabase.co is IPv6-only and fails on many networks.
spring.profiles.active=prod

DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=<your-supabase-db-password>
JWT_SECRET=<long-random-string>

# File storage: keep local for development, use Supabase for deployed environments.
STORAGE_TYPE=local
# Set STORAGE_TYPE=supabase and create a public media bucket plus a private documents bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=gharse-media
SUPABASE_PRIVATE_BUCKET=gharse-documents

# Set PAYMENT_PROVIDER=razorpay to enable Razorpay checkout.
# Keep the key secret server-side; only the key ID is returned to the frontend.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: create an admin account on startup
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
